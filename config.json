{
  "adapter_folder": "minedojo",
  "llm": {
    "enabled": false,
    "provider": "openai",
    "model": "gpt-4.1-mini",
    "temperature": 0.1,
    "max_tokens": 500,
    "timeout_s": 1.0
  },
  "adapter_config": {
    "task_id": "harvest_milk",
    "image_size": [
      160,
      256
    ]
  },
  "policy_generator": {
    "weights": {
      "goal_coherence": 0.6,
      "prediction_error": 0.4,
      "allostatic_survival_fit": 0.2,
      "allostatic_urgency_alignment": 0.2
