{
  "adapter_folder": "animalai",
  "adapter_config": {
    "homeostatic": {
      "health_depletion_rate": 0.001,
      "saturation_depletion_rate": 0.002,
      "food_health_restore": 0.3,
      "food_saturation_restore": 0.5,
      "hazard_health_penalty": 0.2,
      "death_threshold": 0.0
    },
    "simulation": {
      "arena_size": 30.0,
      "step_size": 1.0,
      "turn_angle_deg": 15.0,
      "interaction_radius": 2.0,
      "hazard_margin": 2.0,
      "n_food": 5,
      "seed": null
    },
    "arena_config": "animalai_configs/basic_food.yaml",
    "worker_id": 1,
    "base_port": 5005,
    "file_name": "./animal-ai-unity/AnimalAI.app"
  },
  "llm": {
    "enabled": true,
    "provider": "anthropic",
    "model": "claude-sonnet-4-6",
    "temperature": 0.1,
    "max_tokens": 500,
    "timeout_s": 15.0
  },
  "policy_generator": {
    "llm_conflict_threshold": 0.8,
    "pe_streak_threshold": 5,
    "pe_high_threshold": 0.7,
    "llm_reeval_interval": 10,
    "skill_gap_urgency_threshold": 0.8,
    "plan_window": 20,
    "max_plan_phases": 5,
    "weights": {
      "goal_coherence": 0.6,
      "prediction_error": 0.4,
      "allostatic_survival_fit": 0.2,
      "allostatic_urgency_alignment": 0.2
    },
    "fallback_scores": {
      "goal_coherence": 0.5,
      "prediction_error": 0.5,
      "allostatic_survival_fit": 0.5,
      "allostatic_urgency_alignment": 0.5
    }
  },
  "allostatic_controller": {
    "planning_horizon": 50,
    "history_window": 20,
    "irreversibility_bonus": 0.3,
    "recovery_weight_factor": 0.2,
    "urgency_tie_epsilon": 0.05,
    "threat_prior_weight": 0.3,
    "min_confidence": 0.5
  },
  "world_model": {
    "alpha": 0.1,
    "action_confidence_threshold": 20,
    "min_precision": 0.3
  },
  "perceptual_prediction_error": {
    "alpha": 0.1,
    "epsilon": 0.01,
    "sigma_clip": 3.0,
    "default_precision": 0.5,
    "min_precision": 0.3
  },
  "arousal_valence": {
    "w_health": 0.35,
    "w_saturation": 0.25,
    "w_threat": 0.30,
    "w_pred_err": 0.10,
    "v_health": 0.30,
    "v_saturation": 0.25,
    "v_resource": 0.20,
    "v_safety": 0.25
  },
  "memory": {
    "working_memory_capacity": 100,
    "faiss_k_default": 5,
    "pe_ema_alpha": 0.1,
    "pe_min_observations": 5,
    "faiss_epsilon": 1e-6,
    "episode_length": 1000,
    "long_term_memory_path": "data/long_term_memory",
    "max_score_history": 200,
    "max_outcome_history": 200
  },
  "observability": {
    "log_root": "src/logs/runs"
  }
}