        },
        {
          "id": "hunger",
          "setpoint": 0.8,
          "critical_threshold": 0.2,
          "irreversible": false,
          "recovery_cost_ticks": 20,
          "suggested_action_tag": "eat"
        },
        {
          "id": "oxygen",
          "setpoint": 0.9,
          "critical_threshold": 0.2,
          "irreversible": true,
          "recovery_cost_ticks": 30,
          "suggested_action_tag": "surface"
